# Caddyfile for audio-inference.oshara.ai
# Routes HTTPS/WSS requests to STT, TTS, and LiveKit (signaling + Twirp API).
#
# Browser / SDK URL: wss://audio-inference.oshara.ai
# (LiveKit appends /rtc for signaling; Twirp uses /twirp/*.)
# Media still uses UDP on the host: TURN 3478/udp + RTC range (e.g. 50000-50100/udp)
# and tcp 7881 as configured on the LiveKit server — open those in the AWS security group.

audio-inference.oshara.ai {
    # Proxy STT (ASR) API under /stt/* to the ASR container on shared Docker network
    handle_path /stt/* {
        reverse_proxy asr:8000
    }

    # Proxy Gemma API under /gemma/* to the Gemma container on shared Docker network
    handle_path /gemma/* {
        reverse_proxy host.docker.internal:8022
    }

    # Proxy TTS endpoints under /tts/* to the Chatterbox TTS server.
    # health_uri + lb_try_duration: when the container restarts after a CUDA
    # error, Caddy will keep retrying the upstream for up to 3 minutes rather
    # than immediately returning 502 to the caller.  Combined with the 503 +
    # Retry-After response the server emits during its drain window, this
    # effectively queues in-flight requests at the proxy layer.
    handle_path /tts/* {
        reverse_proxy chatterbox-streaming-multilingual:8010 {
            health_uri        /health
            health_interval   10s
            health_timeout    3s
            health_status     200
            lb_try_duration   180s
            lb_try_interval   3s
            flush_interval    -1
        }
    }

    # Proxy Model Updater API under /model-updater/*
    handle_path /model-updater/* {
        reverse_proxy host.docker.internal:8002
    }

    # Proxy MCP server under /mcp/*
    handle_path /mcp* {
        reverse_proxy host.docker.internal:8008
    }

    # MLflow Tracking UI.
    # SCRIPT_NAME=/mlflow is set in the systemd service so Flask prefixes all
    # URLs it generates (including JS API calls) with /mlflow. Caddy must NOT
    # strip the prefix — pass the full path so Werkzeug can strip SCRIPT_NAME
    # for routing. Host override is required because MLflow 3 validates Host.
    handle /mlflow* {
        reverse_proxy host.docker.internal:5000 {
            header_up Host localhost
        }
    }

    # Session token issuer (LiveKit JWT): canonical v1 path + compatibility aliases
    @token_issuer path /v1/session-token /session-token /livekit/session-token /livekit/v1/session-token
    handle @token_issuer {
        reverse_proxy host.docker.internal:8787
    }

    # LiveKit: WebSocket signaling (/rtc*) and HTTP Twirp API (/twirp*)
    @livekit path /rtc* /twirp*
    handle @livekit {
        reverse_proxy host.docker.internal:7880 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Optional prefix: client may use wss://audio-inference.oshara.ai/livekit (path → /rtc, /twirp, …)
    handle_path /livekit/* {
        reverse_proxy host.docker.internal:7880 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Fallback: simple discovery text
    handle {
        respond "audio-inference.oshara.ai — use /stt/, /tts/, /rtc, /twirp/, or /livekit/* (see README)." 200
    }

    log {
        output stdout
        format console
        level INFO
    }

    header {
        X-Content-Type-Options nosniff
        X-XSS-Protection "1; mode=block"
        X-Frame-Options DENY
    }
}

monitor.oshara.ai {
    reverse_proxy host.docker.internal:3000

    log {
        output stdout
        format console
        level INFO
    }
}
