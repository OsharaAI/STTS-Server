# Caddyfile for audio-inference.oshara.ai
# Routes requests to the ASR (STT) and TTS services.

audio-inference.oshara.ai {
    # Proxy STT (ASR) API under /stt/* to the ASR container on shared Docker network
    handle_path /stt/* {
        reverse_proxy asr:8000
    }

    # Proxy TTS endpoints under /tts/* to the Chatterbox TTS server
    handle_path /tts/* {
        reverse_proxy host.docker.internal:4000
    }

    # Fallback: direct root path to a simple status message or redirect
    handle_path / {
        respond "audio-inference reverse proxy: use /stt/ or /tts/" 200
    }

    # Enable request logging
    log {
        output stdout
        format console
        level INFO
    }

    # Add security headers
    header {
        X-Content-Type-Options nosniff
        X-XSS-Protection "1; mode=block"
        X-Frame-Options DENY
    }
}
